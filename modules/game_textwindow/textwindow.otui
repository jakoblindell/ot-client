TextWindow < MainWindow
  id: textWindow
  size: 300 450

  Item
    id: textItem
    virtual: true
    anchors.top: parent.top
    anchors.left: parent.left
    background-color: #00000000

  Label
    id: description
    anchors.top: parent.top
    anchors.left: textItem.right
    anchors.right: parent.right
    margin-left: 8
    margin-top: 5
    text-auto-resize: true
    text-align: left
    text-wrap: true

  MultilineTextEdit
    id: text
    anchors.top: description.bottom
    anchors.left: parent.left
    anchors.right: textScroll.left
    anchors.bottom: separator.top
    margin-top: 10
    margin-bottom: 10
    vertical-scrollbar: textScroll
    text-wrap: true

  VerticalScrollBar
    id: textScroll
    anchors.top: description.bottom
    anchors.bottom: separator.top
    anchors.right: parent.right
    margin-top: 10
    margin-bottom: 10
    step: 16
    pixels-scroll: true

  HorizontalSeparator
    id: separator
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 40

  Button
    id: okButton
    !text: tr('Ok')
    anchors.bottom: parent.bottom
    anchors.right: cancelButton.left
    margin-right: 10
    margin-bottom: 10
    width: 50
    height: 25

  Button
    id: cancelButton
    !text: tr('Cancel')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 10
    margin-right: 10
    width: 80
    height: 25

// Touch layouts (ot-client#124, option 1): a small modal over the dimmed
// game. Title and close at the top, the writer, the text on paper, then the
// count and Save. textwindow.lua sizes and places the panel (above the
// on-screen keyboard while it is open) and switches it to one header row
// (title, Save, close) when there is little height.
TouchTextWindow < UIWindow
  anchors.fill: parent
  background-color: $ot-backdrop
  draggable: false
  focusable: true
  phantom: false

  OtPanel
    id: panel
    size: 361 400
    padding: 8
    focusable: true

    OtIconButton
      id: closeButton
      !text: 'X'
      anchors.top: parent.top
      anchors.right: parent.right

    OtTitle
      id: title
      anchors.verticalCenter: closeButton.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter

    OtHint
      id: writer
      anchors.top: closeButton.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-left: 2

    OtPaper
      id: text
      anchors.top: writer.bottom
      anchors.left: parent.left
      anchors.right: textScroll.left
      anchors.bottom: saveButton.top
      margin-top: 6
      margin-bottom: 8
      vertical-scrollbar: textScroll

    VerticalScrollBar
      id: textScroll
      anchors.top: text.top
      anchors.bottom: text.bottom
      anchors.right: parent.right
      step: 18
      pixels-scroll: true

    Label
      id: count
      anchors.left: parent.left
      anchors.verticalCenter: saveButton.verticalCenter
      margin-left: 2
      font: $ot-font-text
      color: $ot-text-muted
      text-auto-resize: true

    OtButtonPrimary
      id: saveButton
      !text: tr('Save')
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 120
