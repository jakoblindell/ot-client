// Automations (automations.lua), built from the ot-ui styles
// (data/styles/50-ot-ui.otui). Compact: two tabs. General: columns of
// switches, one "?" for all of them, and where loot goes. Loot list: the
// items to take from corpses, each with its own container.

// One switch: the box and its name; a tap anywhere on it toggles
AutomationToggle < UIWidget
  height: 40
  phantom: false

  OtCheck
    id: check
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter

  OtLabel
    id: text
    anchors.left: check.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    phantom: true

// An item on the loot list: picture, name, its container (tap to change)
// and remove
LootListRow < UIWidget
  height: 40
  margin-bottom: 2

  Item
    id: item
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true
    phantom: true

  OtLabel
    id: name
    anchors.left: item.right
    anchors.right: target.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 6
    phantom: true

  OtButton
    id: target
    anchors.right: remove.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    width: 120

  OtIconButton
    id: remove
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    !text: 'X'

AutomationsSheet < OtBackdrop
  OtPanel
    id: panel
    anchors.centerIn: parent
    width: 600
    height: 260

    OtHelpButton
      id: help
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 8

    OtTitle
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      !text: tr('Automations')

    OtIconButton
      id: close
      anchors.top: parent.top
      anchors.right: parent.right
      !text: 'X'

    OtTabRow
      id: tabs
      anchors.top: close.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6

    UIWidget
      id: general
      anchors.top: tabs.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6

      UIWidget
        id: toggles
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        layout:
          type: grid
          cell-size: 200 40
          cell-spacing: 2
          flow: true
          fit-children: true

      OtLabel
        id: lootToLabel
        anchors.top: toggles.bottom
        anchors.left: parent.left
        margin-top: 12
        text-auto-resize: true
        !text: tr('Put loot in')

      UIWidget
        id: lootTo
        anchors.top: lootToLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        height: 40
        layout:
          type: horizontalBox
          spacing: 4

    UIWidget
      id: lootPage
      anchors.top: tabs.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      visible: false

      // the filter in use: a drop-down (LootChooser)
      OtButton
        id: filter
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        text-align: left
        text-offset: 12 0

      UIWidget
        id: actions
        anchors.top: filter.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        height: 40
        layout:
          type: horizontalBox
          spacing: 4

      OtHint
        id: empty
        anchors.top: actions.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6

      ScrollablePanel
        id: list
        anchors.top: actions.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 6
        margin-right: 14
        vertical-scrollbar: listScroll
        layout:
          type: verticalBox

      VerticalScrollBar
        id: listScroll
        anchors.top: list.top
        anchors.bottom: list.bottom
        anchors.right: parent.right
        step: 42
        pixels-scroll: true

// A list to choose from, with a search when there are many (the filter
// drop-down, the monsters in Add loot)
LootChooser < OtBackdrop
  OtPanel
    id: panel
    anchors.centerIn: parent
    size: 420 420

    OtTitle
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10

    OtIconButton
      id: close
      anchors.top: parent.top
      anchors.right: parent.right
      !text: 'X'

    TextEdit
      id: search
      anchors.top: close.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 36
      max-length: 30
      placeholder: Search

    ScrollablePanel
      id: list
      anchors.top: search.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      margin-right: 14
      vertical-scrollbar: listScroll
      layout:
        type: verticalBox
        spacing: 2

    VerticalScrollBar
      id: listScroll
      anchors.top: list.top
      anchors.bottom: list.bottom
      anchors.right: parent.right
      step: 42
      pixels-scroll: true

// Add loot: what monsters drop, a-z, ticked when it is in the filter
LootPickRow < UIWidget
  height: 40
  phantom: false

  OtCheck
    id: check
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true

  Item
    id: item
    anchors.left: check.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    virtual: true
    phantom: true

  OtLabel
    id: name
    anchors.left: item.right
    anchors.right: rarity.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    phantom: true

  Label
    id: rarity
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    font: $ot-font-text
    text-auto-resize: true
    phantom: true

LootPicker < OtBackdrop
  OtPanel
    id: panel
    anchors.centerIn: parent
    size: 560 460

    OtTitle
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10

    OtIconButton
      id: close
      anchors.top: parent.top
      anchors.right: parent.right
      !text: 'X'

    OtButton
      id: creature
      anchors.top: close.bottom
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      margin-top: 6
      margin-right: 3
      text-align: left
      text-offset: 12 0

    TextEdit
      id: search
      anchors.top: creature.top
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      margin-left: 3
      height: 40
      max-length: 30
      placeholder: Search an item

    OtHint
      id: count
      anchors.top: creature.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4

    ScrollablePanel
      id: list
      anchors.top: count.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-right: 14
      vertical-scrollbar: listScroll
      layout:
        type: verticalBox
        spacing: 2

    VerticalScrollBar
      id: listScroll
      anchors.top: list.top
      anchors.bottom: list.bottom
      anchors.right: parent.right
      step: 42
      pixels-scroll: true

// A name or a filter code to type or paste
LootFilterPrompt < OtBackdrop
  OtPanel
    id: box
    anchors.centerIn: parent
    size: 360 160
    padding: 10

    OtTitle
      id: title
      anchors.top: parent.top
      anchors.left: parent.left

    TextEdit
      id: text
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      height: 36

    OtButton
      id: cancel
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 150
      !text: tr('Cancel')

    OtButtonPrimary
      id: ok
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 150
      !text: tr('OK')

// The "?" explanation
AutomationsHelp < OtBackdrop
  OtPanel
    id: box
    anchors.centerIn: parent
    width: 520
    height: 300
    phantom: true

    OtText
      id: text
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      phantom: true

    OtHint
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Tap to close')
      phantom: true
