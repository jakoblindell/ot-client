// Automations (automations.lua), built from the ot-ui styles
// (data/styles/50-ot-ui.otui). Compact: two columns of switches, one "?"
// for all of them, and where loot goes.

// One switch: the box and its name; a tap anywhere on it toggles
AutomationToggle < UIWidget
  height: 40
  phantom: false

  OtCheck
    id: check
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter

  OtLabel
    id: text
    anchors.left: check.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    phantom: true

AutomationsSheet < OtBackdrop
  OtPanel
    id: panel
    anchors.centerIn: parent
    width: 440
    height: 260

    OtHelpButton
      id: help
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 8

    OtTitle
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      !text: tr('Automations')

    OtIconButton
      id: close
      anchors.top: parent.top
      anchors.right: parent.right
      !text: 'X'

    UIWidget
      id: toggles
      anchors.top: close.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      layout:
        type: grid
        cell-size: 200 40
        cell-spacing: 2
        flow: true
        fit-children: true

    OtLabel
      id: lootToLabel
      anchors.top: toggles.bottom
      anchors.left: parent.left
      margin-top: 12
      text-auto-resize: true
      !text: tr('Put loot in')

    UIWidget
      id: lootTo
      anchors.top: lootToLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 40
      layout:
        type: horizontalBox
        spacing: 4

// The "?" explanation
AutomationsHelp < OtBackdrop
  OtPanel
    id: box
    anchors.centerIn: parent
    width: 400
    height: 240
    phantom: true

    OtText
      id: text
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      phantom: true

    OtHint
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Tap to close')
      phantom: true
