// Built from the ot-ui styles (data/styles/50-ot-ui.otui)
HotbarSheetRow < UIButton
  height: 52
  border-width-bottom: 1
  border-color-bottom: #ffffff14
  $pressed:
    background-color: #00000040

  Item
    id: item
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    virtual: true
    phantom: true
    visible: false

  UIWidget
    id: icon
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    phantom: true
    visible: false

  Label
    id: badge
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    font: $ot-font-label
    color: $ot-gold
    text-auto-resize: true
    phantom: true

  Label
    id: title
    anchors.left: parent.left
    anchors.right: badge.left
    anchors.top: parent.top
    margin-left: 48
    margin-right: 6
    margin-top: 7
    font: $ot-font-label
    color: $ot-text-strong
    phantom: true

  Label
    id: subtitle
    anchors.left: title.left
    anchors.right: title.right
    anchors.top: title.bottom
    margin-top: 3
    font: $ot-font-text
    color: $ot-text-muted
    phantom: true

HotbarSheetHeading < Label
  height: 28
  font: $ot-font-label
  color: $ot-gold
  text-offset: 4 10

HotbarSheetButton < OtButton

HotbarSheet < OtBackdrop
  OtPanel
    id: panel
    anchors.centerIn: parent
    size: 420 520

    Label
      id: title
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: close.left
      height: 34
      font: $ot-font-title
      color: $ot-text-strong
      text-align: left

    HotbarSheetButton
      id: close
      anchors.top: parent.top
      anchors.right: parent.right
      size: 40 40
      !text: 'X'

    UIWidget
      id: tabs
      anchors.top: title.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 40
      layout:
        type: grid
        cell-size: 94 40
        cell-spacing: 6
        num-columns: 4
        flow: true

    UIWidget
      id: filters
      anchors.top: tabs.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 40
      layout:
        type: horizontalBox
        spacing: 6

    ScrollablePanel
      id: list
      anchors.top: filters.bottom
      anchors.left: parent.left
      anchors.right: listScroll.left
      anchors.bottom: footer.top
      margin-top: 8
      margin-bottom: 8
      vertical-scrollbar: listScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: listScroll
      anchors.top: filters.bottom
      anchors.bottom: footer.top
      anchors.right: parent.right
      margin-top: 8
      margin-bottom: 8
      step: 52
      pixels-scroll: true

    UIWidget
      id: textPanel
      anchors.top: tabs.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: footer.top
      margin-top: 8
      visible: false

      Label
        id: help
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        text-wrap: true
        text-auto-resize: true
        font: $ot-font-text
        color: $ot-text-muted
        !text: tr('Sent to the chat when you press the button. Spell words work too.')

      TextEdit
        id: input
        anchors.top: help.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 10
        height: 40
        font: $ot-font-text
        placeholder: e.g. exura, utani hur, hi

      UIWidget
        id: examples
        anchors.top: input.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 10
        height: 40
        layout:
          type: horizontalBox
          spacing: 6

      HotbarSheetButton
        id: confirm
        anchors.top: examples.bottom
        anchors.right: parent.right
        margin-top: 14
        width: 110
        !text: tr('Confirm')

    UIWidget
      id: footer
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 40
      layout:
        type: horizontalBox
        spacing: 8

      OtButtonDanger
        id: clear
        width: 120
        !text: tr('Clear slot')

      HotbarSheetButton
        id: more
        width: 140
        !text: tr('More options')

// Hotbar presets (hotbar_presets.lua): the P and pencil buttons next to the
// hotbar, the edit mode layer over it, and the hotbar settings sheet
// A round button like the hotbar slots: text (P1) or an icon (the pencil),
// gold when on
MobileHotbarRoundButton < UIButton
  size: 40 40
  image-source: /mods/client_mobile/images/slot_round
  font: $ot-font-label
  color: $ot-text
  icon-size: 22 22
  icon-align: center
  focusable: false
  $pressed:
    image-source: /mods/client_mobile/images/slot_round_pressed
  $on:
    color: $ot-gold

MobileHotbarPresetRow < UIWidget
  size: 84 40
  phantom: true
  layout:
    type: horizontalBox
    spacing: 4

  MobileHotbarRoundButton
    id: preset
    !text: 'P1'

  MobileHotbarRoundButton
    id: edit
    !tooltip: tr('Edit hotbar')

    // (a child, so it stays centred when the button is sized; icon-source
    // drew it into a corner)
    UIWidget
      id: icon
      anchors.fill: parent
      margin: 10
      image-source: /images/ui/ot/icons/edit
      image-smooth: true
      phantom: true

MobileHotbarEditOverlay < UIWidget
  phantom: false
  focusable: false
  background-color: #e0b84c22
  border-width: 2
  border-color: $ot-gold

MobileHotbarChoiceRow < UIWidget
  height: 40
  layout:
    type: grid
    cell-size: 50 40
    cell-spacing: 6
    flow: true
    fit-children: true

MobileHotbarNote < OtHint
  margin-top: 3
  margin-bottom: 6

HotbarSettingsSheet < OtBackdrop
  OtPanel
    id: panel
    anchors.centerIn: parent
    size: 420 520

    Label
      id: title
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: close.left
      height: 34
      font: $ot-font-title
      color: $ot-text-strong
      !text: tr('Hotbar')

    HotbarSheetButton
      id: close
      anchors.top: parent.top
      anchors.right: parent.right
      size: 40 40
      !text: 'X'

    ScrollablePanel
      id: list
      anchors.top: title.bottom
      anchors.left: parent.left
      anchors.right: listScroll.left
      anchors.bottom: parent.bottom
      margin-top: 6
      margin-right: 4
      vertical-scrollbar: listScroll
      layout:
        type: verticalBox
        spacing: 2

    VerticalScrollBar
      id: listScroll
      anchors.top: title.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 6
      step: 40
      pixels-scroll: true

MobileHotbarToggleRow < UIWidget
  height: 40
  layout:
    type: grid
    cell-size: 130 40
    cell-spacing: 6
    flow: true
