// A panel's button on the bottom bar (icons: data/images/ui/ot/icons, white):
// boxed, a gold outline on a faint fill, while its panel is on the screen
MobileToolbarButton < UIButton
  size: 46 40
  margin-left: 2
  margin-right: 2
  icon-size: 26 26
  icon-align: center
  background-color: alpha
  border-width: 1
  border-color: #00000000
  $checked:
    background-color: #e0b84c1c
    border-color: $ot-gold
  $pressed:
    background-color: #ffffff33

// The menu button, first on the bar: always a boxed stone button
MobileToolbarMenuButton < MobileToolbarButton
  image-source: /images/ui/button-9grid-idle
  image-border: 4
  $checked:
    image-source: /images/ui/button-9grid-pressed
    background-color: alpha
    border-color: $ot-gold
  $pressed:
    image-source: /images/ui/button-9grid-pressed

// The thin line between the panels' buttons
MobileToolbarDivider < UIWidget
  size: 1 24
  margin-left: 2
  margin-right: 2
  margin-top: 8
  background-color: #ffffff30
  phantom: true

MobileToolbar < UIWidget
  height: 44
  background-color: #141414ee
  border-width-top: 1
  border-color-top: #3a3a3a

  UIWidget
    id: buttons
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    height: 40
    layout:
      type: horizontalBox
      fit-children: true

// A health or mana bar: a dark rounded trough with a glossy fill and the
// numbers in the middle (images/bar_*.png)
MobileStatBar < UIWidget
  height: 22
  image-source: /mods/client_mobile/images/bar_frame
  image-border: 5
  phantom: true

  UIWidget
    id: fill
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 1
    width: 0
    image-border: 5
    phantom: true

  Label
    id: text
    anchors.fill: parent
    text-align: center
    font: $ot-font-label
    color: $ot-text-strong
    phantom: true

// Health and mana side by side: in the bottom bar (landscape) or under the
// game view (portrait)
MobileStats < UIWidget
  height: 22
  phantom: true

  MobileStatBar
    id: health
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    margin-right: 3
    @onSetup: self.fill:setImageSource('/mods/client_mobile/images/bar_health')

  MobileStatBar
    id: mana
    anchors.top: parent.top
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    margin-left: 3
    @onSetup: self.fill:setImageSource('/mods/client_mobile/images/bar_mana')

// Round like the hotbar slots (and as big), with the chat icon (gold while
// open). The face is set by setRoundFace (mobile.lua).
MobileChatButton < UIButton
  size: 40 40
  image-source: /mods/client_mobile/images/slot_round
  $pressed:
    image-source: /mods/client_mobile/images/slot_round_pressed

  // (a child, so it stays centred when the button is sized)
  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 24 24
    image-source: /images/ui/ot/icons/chat
    phantom: true

  // Unread messages while the chat is closed
  Label
    id: badge
    size: 24 24
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -8
    margin-right: -8
    image-source: /mods/client_mobile/images/badge
    image-color: #d23030
    text-align: center
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true
    visible: false

// A panel as a piece of the layout (panels.lua): the windows in it (mini
// windows bring their own title bar)
MobilePanelPiece < UIMiniWindowContainer
  focusable: false
  phantom: false
  image-source: /images/ui/miniwindow_body
  image-border: 4
  layout:
    type: verticalBox

// The title bar of equipment and the map: as the mini windows' (15 px, the
// name, - and x)
MobilePanelHeader < UIWidget
  height: 15
  image-source: /images/ui/miniwindow_header
  image-border: 4
  phantom: true

  Label
    id: title
    anchors.left: parent.left
    anchors.right: minimize.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-antialised
    color: #c0c0c0
    phantom: true

  UIButton
    id: close
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 3
    size: 12 12
    image-size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 28 0 14 14
    $pressed:
      image-clip: 28 28 14 14

  UIButton
    id: minimize
    anchors.top: close.top
    anchors.right: close.left
    margin-right: 1
    size: 12 12
    image-size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 0 0 14 14
    $pressed:
      image-clip: 0 28 14 14
    $on:
      image-clip: 14 0 14 14

// Edit layout (edit.lua) ----------------------------------------------------

// Over the game view while editing: the map dims
MobileEditDim < UIWidget
  background-color: #00000099
  phantom: true

// A dashed gold line (one side of a piece's outline)
MobileEditDashH < UIWidget
  height: 2
  image-source: /mods/client_mobile/images/edit_dash_h
  image-repeated: true
  phantom: true

MobileEditDashV < UIWidget
  width: 2
  image-source: /mods/client_mobile/images/edit_dash_v
  image-repeated: true
  phantom: true

// A round - or + in the middle of a piece; the face is set by setRoundFace
MobileEditRoundButton < UIButton
  size: 34 34
  icon-size: 16 16
  icon-align: center

// The outline over a piece while editing: dashed, exactly the piece's
// size, its name, and - and + for its size in the middle. One finger drags
// it.
MobileEditFrame < UIWidget
  draggable: true
  focusable: false
  background-color: #00000030
  $on:
    background-color: #e0b84c26

  MobileEditDashH
    id: top
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  MobileEditDashH
    id: bottom
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  MobileEditDashV
    id: left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left

  MobileEditDashV
    id: right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right

  Label
    id: name
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.verticalCenter
    margin-bottom: 2
    font: $ot-font-label
    color: $ot-gold
    text-auto-resize: true
    phantom: true

  UIWidget
    id: sizes
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.verticalCenter
    size: 76 34
    phantom: true

    MobileEditRoundButton
      id: smaller
      anchors.left: parent.left
      anchors.top: parent.top
      icon-source: /mods/client_mobile/images/edit_minus

    MobileEditRoundButton
      id: bigger
      anchors.right: parent.right
      anchors.top: parent.top
      icon-source: /mods/client_mobile/images/edit_plus

// "Customize Layout": a small window in the middle of the game view
MobileEditDialog < OtPanel
  size: 236 136
  padding: 10

  OtTitle
    id: title
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    !text: tr('Customize Layout')

  OtButtonPrimary
    id: save
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    margin-top: 10
    margin-right: 4
    !text: tr('Save')

  OtButtonDanger
    id: reset
    anchors.top: save.top
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    margin-left: 4
    !text: tr('Reset')

  OtButton
    id: center
    anchors.top: save.bottom
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    margin-top: 6
    margin-right: 4
    !text: tr('Center')

  OtButton
    id: cancel
    anchors.top: center.top
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    margin-left: 4
    !text: tr('Cancel')

// First-login UI setup (setup.lua): the start and end sheet
MobileSetupSheet < OtBackdrop
  OtPanel
    id: panel
    anchors.centerIn: parent
    width: 380
    height: 180

    OtTitle
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter

    OtText
      id: text
      anchors.top: title.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 12
      // (the wrapped lines run a little past the width otherwise)
      margin-right: 26

    OtButton
      id: skip
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      margin-right: 4

    OtButtonPrimary
      id: start
      anchors.bottom: parent.bottom
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      margin-left: 4

// The bar while placing a piece: what it is, then back, skip and the tick
MobileSetupBar < OtPanel
  height: 104
  padding: 8

  OtLabel
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    color: $ot-gold
    text-auto-resize: true

  OtHint
    id: text
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  OtIconButton
    id: back
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    !text: '<'

  OtButton
    id: skip
    anchors.right: ok.left
    anchors.bottom: parent.bottom
    margin-right: 6
    width: 64
    !text: tr('Skip')

  OtButtonPrimary
    id: ok
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 64 40

    UIWidget
      anchors.centerIn: parent
      size: 24 24
      image-source: /images/ui/ot/icons/check_on
      phantom: true

// Frame rate, latency and build over the game view (gameinfo.lua)
MobileGameInfo < Label
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 4
  margin-left: 4
  // (outlined text, no box: there when you look for it, not eye-catching)
  font: $ot-font-text
  color: $ot-text
  text-auto-resize: true
  phantom: true
