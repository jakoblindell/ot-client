// (icons: data/images/ui/ot/icons, gold while its panel is open)
MobileToolbarButton < UIButton
  size: 46 40
  margin-left: 2
  margin-right: 2
  icon-size: 26 26
  icon-align: center
  background-color: alpha
  border-width: 1
  border-color: #00000000
  $checked:
    background-color: #ffffff22
    border-color: #ffffff55
  // pinned on the screen (pins.lua)
  $on:
    border-color: #d9b45c
  $pressed:
    background-color: #ffffff33

MobileToolbar < UIWidget
  height: 44
  background-color: #141414ee
  border-width-top: 1
  border-color-top: #3a3a3a

  UIWidget
    id: buttons
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    height: 40
    layout:
      type: horizontalBox
      fit-children: true

// A health or mana bar: a dark rounded trough with a glossy fill and the
// numbers in the middle (images/bar_*.png)
MobileStatBar < UIWidget
  height: 22
  image-source: /mods/client_mobile/images/bar_frame
  image-border: 5
  phantom: true

  UIWidget
    id: fill
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 1
    width: 0
    image-border: 5
    phantom: true

  Label
    id: text
    anchors.fill: parent
    text-align: center
    font: $ot-font-label
    color: $ot-text-strong
    phantom: true

// Health and mana side by side: in the bottom bar (landscape) or under the
// game view (portrait)
MobileStats < UIWidget
  height: 22
  phantom: true

  MobileStatBar
    id: health
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    margin-right: 3
    @onSetup: self.fill:setImageSource('/mods/client_mobile/images/bar_health')

  MobileStatBar
    id: mana
    anchors.top: parent.top
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    margin-left: 3
    @onSetup: self.fill:setImageSource('/mods/client_mobile/images/bar_mana')

// Round like the hotbar slots, with the chat icon (gold while open)
MobileChatButton < UIButton
  size: 48 48
  image-source: /mods/client_mobile/images/slot_round
  $pressed:
    image-source: /mods/client_mobile/images/slot_round_pressed

  // (a child, so it stays centred when the button is sized)
  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 28 28
    image-source: /images/ui/ot/icons/chat
    phantom: true

  // Unread messages while the chat is closed
  Label
    id: badge
    size: 24 24
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -8
    margin-right: -8
    image-source: /mods/client_mobile/images/badge
    image-color: #d23030
    text-align: center
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true
    visible: false

MobileEditSizeButton < OtButton
  size: 40 40

// Edit mode: - and + resize a piece, Reset puts it back where it was at
// first (placed next to its frame)
MobileEditSizeBar < OtPanel
  size: 196 52
  padding: 6
  phantom: false
  layout:
    type: horizontalBox
    spacing: 2
  MobileEditSizeButton
    id: smaller
    !text: '-'
  OtValue
    id: size
    width: 52
  MobileEditSizeButton
    id: bigger
    !text: '+'
  MobileEditSizeButton
    id: reset
    width: 52
    !text: tr('Reset')
    color: $ot-text

// Edit mode: a frame over each movable piece, dragged with one finger, with
// a resize corner
MobileEditFrame < UIWidget
  draggable: true
  focusable: false
  background-color: #ffffff18
  border-width: 2
  border-color: #ffffffaa
  $on:
    background-color: #e0b84c30
    border-color: $ot-gold

  UIWidget
    id: resize
    size: 24 24
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: -10
    margin-bottom: -10
    draggable: true
    image-source: /images/ui/button-9grid-idle
    image-border: 4
    border-width: 2
    border-color: $ot-gold

MobileEditBar < OtPanel
  size: 400 56
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter
  margin-top: 6
  padding: 8

  OtHint
    anchors.left: parent.left
    anchors.right: reset.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    text-auto-resize: true
    !text: tr('Drag to move.\nTap, then - / + to resize.')

  OtButtonDanger
    id: reset
    anchors.right: done.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    width: 92
    !text: tr('Reset UI')

  OtButtonPrimary
    id: done
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 80
    !text: tr('Done')


// First-login UI setup (setup.lua): the start and end sheet
MobileSetupSheet < OtBackdrop
  OtPanel
    id: panel
    anchors.centerIn: parent
    width: 380
    height: 180

    OtTitle
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter

    OtText
      id: text
      anchors.top: title.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 12
      // (the wrapped lines run a little past the width otherwise)
      margin-right: 26

    OtButton
      id: skip
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      margin-right: 4

    OtButtonPrimary
      id: start
      anchors.bottom: parent.bottom
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      margin-left: 4

// The bar while placing a piece: what it is, then back, skip and the tick
MobileSetupBar < OtPanel
  height: 104
  padding: 8

  OtLabel
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    color: $ot-gold
    text-auto-resize: true

  OtHint
    id: text
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  OtIconButton
    id: back
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    !text: '<'

  OtButton
    id: skip
    anchors.right: ok.left
    anchors.bottom: parent.bottom
    margin-right: 6
    width: 64
    !text: tr('Skip')

  OtButtonPrimary
    id: ok
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 64 40

    UIWidget
      anchors.centerIn: parent
      size: 24 24
      image-source: /images/ui/ot/icons/check_on
      phantom: true

// Frame rate, latency and build over the game view (gameinfo.lua)
MobileGameInfo < Label
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 4
  margin-left: 4
  // (outlined text, no box: there when you look for it, not eye-catching)
  font: $ot-font-text
  color: $ot-text
  text-auto-resize: true
  phantom: true
