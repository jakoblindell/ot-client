// The hub (hub.lua), built from the ot-ui styles (data/styles/50-ot-ui.otui)
HubGrid < UIWidget
  layout:
    type: grid
    cell-size: 200 56
    cell-spacing: 8
    flow: true
    fit-children: true

HubBigButton < OtButton
  height: 56

// The front page (ot-client#60): a section's title between two lines
HubSection < UIWidget
  height: 26
  margin-top: 6

  Label
    id: text
    anchors.centerIn: parent
    font: $ot-font-label
    color: $ot-gold
    text-auto-resize: true

  UIWidget
    anchors.left: parent.left
    anchors.right: text.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 24
    margin-right: 12
    height: 1
    background-color: #ffffff22

  UIWidget
    anchors.left: text.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    margin-right: 24
    height: 1
    background-color: #ffffff22

// Four buttons a row
HubIconGrid < UIWidget
  layout:
    type: grid
    cell-size: 110 78
    cell-spacing: 8
    flow: true
    fit-children: true

// A button with a game item (or the character) above its name
HubIconButton < OtButton
  height: 78
  text-align: bottom
  text-offset: 0 -8

  UIItem
    id: item
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    size: 44 44
    virtual: true
    phantom: true

  UICreature
    id: creature
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    size: 44 44
    fixed-creature-size: true
    phantom: true
    visible: false

  // the character's level, over the portrait
  Label
    id: badge
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 32
    font: $ot-font-small
    color: $ot-gold
    background-color: #000000b0
    text-auto-resize: true
    text-offset: 0 0
    padding: 1 4
    phantom: true
    visible: false

  // not ready yet
  Label
    id: soon
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 4
    margin-right: 6
    font: $ot-font-small
    color: $ot-text-muted
    text-auto-resize: true
    phantom: true
    visible: false
    !text: tr('Soon')

  $disabled:
    color: $ot-text-disabled

// Settings: Hotbar, Edit layout, All options in one row
HubSettingsActions < UIWidget
  height: 40
  margin-bottom: 6
  layout:
    type: grid
    cell-size: 150 40
    cell-spacing: 6
    flow: true

// Account and time, under the title
HubStatus < Label
  height: 24
  font: $ot-font-label
  text-align: center

HubLogout < OtButtonDanger
  height: 44
  margin-top: 12
  !text: tr('Logout')

HubSheet < OtBackdrop
  OtPanel
    id: panel
    anchors.centerIn: parent
    size: 500 560

    OtIconButton
      id: back
      anchors.top: parent.top
      anchors.left: parent.left
      width: 90
      visible: false

    OtTitle
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10

    OtIconButton
      id: close
      anchors.top: parent.top
      anchors.right: parent.right
      !text: 'X'

    OtButton
      id: contrast
      anchors.top: parent.top
      anchors.right: close.left
      margin-right: 6
      width: 40

      // the half-circle (ot-client#52), gold when contrast is on
      UIWidget
        id: icon
        anchors.centerIn: parent
        size: 24 24
        image-source: /images/ui/ot/icons/contrast
        phantom: true

    OtTabRow
      id: tabs
      anchors.top: close.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      visible: false

    ScrollablePanel
      id: list
      anchors.top: tabs.bottom
      anchors.left: parent.left
      anchors.right: listScroll.left
      anchors.bottom: parent.bottom
      margin-top: 10
      margin-right: 6
      vertical-scrollbar: listScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: listScroll
      anchors.top: tabs.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 10
      step: 52
      pixels-scroll: true

HubHelp < OtBackdrop
  OtPanel
    id: box
    anchors.centerIn: parent
    width: 360
    height: 130
    phantom: true

    OtText
      id: text
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      phantom: true

    OtHint
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Tap to close')
      phantom: true

// The character sheet (character.lua, ot-client#60) ---------------------------

// Outfit, name, level and vocation, premium, and the Outfit button
CharacterHeader < UIWidget
  height: 92

  UICreature
    id: outfit
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 80 80
    phantom: true

  OtTitle
    id: name
    anchors.left: outfit.right
    anchors.top: parent.top
    margin-left: 10
    margin-top: 10

  OtLabel
    id: vocation
    anchors.left: name.left
    anchors.top: name.bottom
    margin-top: 6
    text-auto-resize: true

  Label
    id: premium
    anchors.left: name.left
    anchors.top: vocation.bottom
    margin-top: 6
    font: $ot-font-text
    text-auto-resize: true

  OtButton
    id: outfitButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 110
    !text: tr('Outfit')

// A name and a value
CharacterRow < UIWidget
  height: 34
  border-width-bottom: 1
  border-color: #ffffff14

  OtLabel
    id: name
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    text-auto-resize: true

  Label
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    font: $ot-font-text
    color: $ot-text
    text-auto-resize: true

// A skill: the value and how far to the next (a thin gold line)
CharacterSkillRow < CharacterRow

  UIWidget
    id: track
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 1
    height: 3
    background-color: #ffffff10
    phantom: true

  UIWidget
    id: fill
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 1
    height: 3
    width: 0
    background-color: $ot-gold-dark
    phantom: true

// Has it or not: a dot (green when on) before the name
CharacterCheckRow < CharacterRow

  UIWidget
    id: dot
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 10 10
    border-width: 5
    border-color: #6a6a6a
    $on:
      border-color: $ot-positive

